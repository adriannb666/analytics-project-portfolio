{
  "name": "PlanAnswer",
  "type": "object",
  "properties": {
    "trading_plan_id": {
      "type": "string"
    },
    "step_key": {
      "type": "string"
    },
    "question_key": {
      "type": "string"
    },
    "answer_value": {
      "type": "string"
    },
    "answer_text": {
      "type": "string"
    }
  },
  "required": [
    "trading_plan_id",
    "question_key"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}