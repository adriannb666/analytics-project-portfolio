{
  "name": "PsychologyRule",
  "type": "object",
  "properties": {
    "trading_plan_id": {
      "type": "string"
    },
    "issue_key": {
      "type": "string"
    },
    "issue_name": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "\u5076\u5c14\u53d1\u751f",
        "\u7ecf\u5e38\u53d1\u751f",
        "\u5df2\u9020\u6210\u660e\u663e\u4e8f\u635f"
      ]
    },
    "recommended_rule": {
      "type": "string"
    },
    "final_rule": {
      "type": "string"
    },
    "is_confirmed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "trading_plan_id",
    "issue_key"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}