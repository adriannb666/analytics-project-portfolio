{
  "name": "RiskAlert",
  "type": "object",
  "properties": {
    "connection_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "enum": [
        "hyperliquid",
        "lighter"
      ]
    },
    "symbol": {
      "type": "string"
    },
    "alert_key": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "high",
        "critical"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "current_value": {
      "type": "string"
    },
    "limit_value": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acknowledged",
        "resolved"
      ],
      "default": "active"
    },
    "first_detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_detected_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "connection_id",
    "alert_key",
    "severity"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}