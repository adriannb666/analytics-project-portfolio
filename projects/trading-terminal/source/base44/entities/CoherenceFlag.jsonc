{
  "name": "CoherenceFlag",
  "type": "object",
  "properties": {
    "trading_plan_id": {
      "type": "string"
    },
    "flag_key": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "affected_steps": {
      "type": "string"
    },
    "current_values": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "resolved"
      ],
      "default": "open"
    },
    "accepted_reason": {
      "type": "string"
    }
  },
  "required": [
    "trading_plan_id",
    "flag_key"
  ],
  "rls": {
    "create": true,
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}